pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Build') {
            steps { sh 'docker build -t demo-app:latest .' }
        }

        stage('Deploy') {
            steps {
                sh 'docker rm -f demo-app || true'
                sh 'docker run -d --name demo-app -p 80:80 demo-app:latest'
            }
        }
    }
}
